# Public/runtime configuration
ENV=production
DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Render provides DATABASE_URL from the managed PostgreSQL database.
DATABASE_URL=

# Render service wiring
BACKEND_API_HOSTPORT=
BACKEND_API_URL=

# Required secrets - set these in Render Dashboard, never in Git
SECRET_KEY=
OPENAI_API_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# Optional SMTP configuration
SMTP_SERVER=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional Redis/Key Value cache
REDIS_URL=
